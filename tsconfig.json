{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["questions/**/*"],
  "exclude": ["playground", "node_modules", "dist"]
}
